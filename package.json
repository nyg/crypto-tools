{
   "name": "crypto-tools",
   "version": "0.4.0",
   "description": "miscellaneous cryptocurrency tools (formerly binance-staking-overview).",
   "type": "module",
   "repository": {
      "type": "git",
      "url": "git+ssh://git@github.com/nyg/crypto-tools.git"
   },
   "keywords": [
      "crypto",
      "binance",
      "staking",
      "overview",
      "dashboard"
   ],
   "author": "nyg",
   "packageManager": "bun@1.2.16",
   "license": "MIT",
   "bugs": {
      "url": "https://github.com/nyg/crypto-tools/issues"
   },
   "scripts": {
      "dev": "concurrently -n vite,bun -c cyan,magenta \"vite\" \"bun --watch src/server/index.js\"",
      "dev:vite": "vite",
      "dev:server": "bun --watch src/server/index.js",
      "desktop:dev": "bunx electrobun dev --watch",
      "mocked": "VITE_MOCK_DATA=true vite",
      "build": "vite build",
      "build:stable": "bunx electrobun build --env=stable",
      "start": "NODE_ENV=production bun src/server/index.js",
      "lint": "eslint src --fix"
   },
   "dependencies": {
      "@ai-sdk/anthropic": "4.0.24",
      "ai": "7.0.42",
      "big.js": "7.0.1",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "cmdk": "1.1.1",
      "date-fns": "4.4.0",
      "fflate": "0.8.3",
      "hono": "4.12.34",
      "lucide-react": "1.27.0",
      "modern-dijkstra": "1.1.2",
      "qs": "6.15.3",
      "radix-ui": "1.6.7",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "react-router": "8.3.0",
      "recharts": "3.10.1",
      "shadcn": "4.16.0",
      "sonner": "2.0.7",
      "swr": "2.4.2",
      "tailwind-merge": "3.6.0",
      "tw-animate-css": "1.4.0",
      "zod": "4.4.3"
   },
   "devDependencies": {
      "@babel/core": "8.0.1",
      "@babel/eslint-parser": "8.0.1",
      "@babel/preset-typescript": "8.0.1",
      "@tailwindcss/vite": "4.3.3",
      "@vitejs/plugin-react": "6.0.4",
      "concurrently": "10.0.4",
      "electrobun": "1.18.1",
      "eslint": "10.8.0",
      "eslint-plugin-react-hooks": "7.1.1",
      "globals": "17.8.0",
      "tailwindcss": "4.3.3",
      "vite": "8.1.5"
   }
}
